---
// Masthead from Mockup A: J. tile + "Jihoon Chung, Ph.D." in the name face (title-options.html, option C),
// main navigation (fixed order), light/dark switch. No email address on the site: Contact leads to a form.
import JMark from './JMark.astro';
import { url, pagePath } from '../lib/site';
import { profile } from '../lib/data';

const NAV = [
  { label: 'Home', path: '' },
  { label: 'Research', path: 'research/' },
  { label: 'Software', path: 'software/' },
  { label: 'Design', path: 'design/' },
  { label: 'Publications', path: 'publications/' },
  { label: 'Talks', path: 'talks/' },
  { label: 'Teaching & Mentoring', path: 'teaching/' },
  { label: 'CV', path: 'cv/' },
  { label: 'Contact', path: 'contact/' },
];

const here = pagePath(Astro.url.pathname);
const isCurrent = (p: string) => (p === '' ? here === '' : here.startsWith(p));
---
<header class="mast">
  <a class="mark" href={url('')}><JMark /><span class="wm-name">{profile.name}<span class="lt">, {profile.suffix}</span></span></a>
  <nav aria-label="Main">
    <ul>
      {NAV.map((item) => (
        <li><a href={url(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>{item.label}</a></li>
      ))}
    </ul>
  </nav>
  <div class="mast-end">
    <!-- Light/dark switch: shown by the page script (Base.astro), so it stays hidden without JS. -->
    <button class="theme-tg" type="button" aria-label="Switch color mode" title="Switch color mode" hidden>
      <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7z"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></svg>
    </button>
  </div>
</header>
