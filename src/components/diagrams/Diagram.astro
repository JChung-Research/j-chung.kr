---
// Research theme drawing by name (see themes.yml "diagram"). decorative: for thumbnails beside a visible title.
import Idt from './Idt.astro';
import Geb from './Geb.astro';
import Hbi from './Hbi.astro';
interface Props { name: 'idt' | 'geb' | 'hbi'; decorative?: boolean }
const { name, decorative = false } = Astro.props;
---
{name === 'idt' && <Idt decorative={decorative} />}{name === 'geb' && <Geb decorative={decorative} />}{name === 'hbi' && <Hbi decorative={decorative} />}
