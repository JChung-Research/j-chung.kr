---
// Research theme drawing by name (themes.yml "diagram"): the one drawing per theme, used on the homepage theme
// cards and the /research/ cards.
import Idt from './Idt.astro';
import Geb from './Geb.astro';
import Hbi from './Hbi.astro';
interface Props { name: 'idt' | 'geb' | 'hbi' }
const { name } = Astro.props;
---
{name === 'idt' && <Idt />}{name === 'geb' && <Geb />}{name === 'hbi' && <Hbi />}
