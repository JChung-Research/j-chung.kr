---
// Project diagram for the homepage Recent Projects cards, by name (recent.yml "diagram"). Each project gets the
// diagram type that shows its idea: ORBIT a fan-out, the medical office a paired comparison, obXML a schema
// mapping, ifcJSON a layered architecture. Each is drawn only from that project's sources.
import ProjectOrbit from './ProjectOrbit.astro';
import ProjectMedical from './ProjectMedical.astro';
import ProjectObxml from './ProjectObxml.astro';
import ProjectIfcjson from './ProjectIfcjson.astro';
interface Props { name: 'orbit' | 'medical' | 'obxml' | 'ifcjson' }
const { name } = Astro.props;
---
{name === 'orbit' && <ProjectOrbit />}{name === 'medical' && <ProjectMedical />}{name === 'obxml' && <ProjectObxml />}{name === 'ifcjson' && <ProjectIfcjson />}
