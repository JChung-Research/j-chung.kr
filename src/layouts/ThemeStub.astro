---
// Research theme page that is not written yet: stub in the inner template, plus the related items
// already on the homepage and the previous/next theme links.
import Stub from './Stub.astro';
import ThemeNav from '../components/ThemeNav.astro';
import Video from '../components/Video.astro';
import { url } from '../lib/site';
import { themes, pubById, softwareById, plural, escapeHtml, homePubIds, videos } from '../lib/data';

interface Props { slug: string }
const i = themes.findIndex((t) => t.slug === Astro.props.slug);
const t = themes[i];
const papers = t.papers.map((id) => pubById(id));
const code = t.code.map((id) => softwareById(id));
const paperLinks = papers
  .map((p) => (homePubIds.has(p.id) ? `<a href="${url(`#p-${p.id}`)}">${escapeHtml(p.short)}</a>` : `<a href="https://doi.org/${p.doi}">${escapeHtml(p.short)}</a>`))
  .join(' · ');
const vids = videos.filter((v) => v.theme === t.slug);
const codeLinks = code.map((s) => `<a href="${url(`#sw-${s.id}`)}">${escapeHtml(s.name)}</a>`).join(' · ');
---
<Stub
  title={t.title}
  description={t.sentence}
  crumbs={[{ label: 'Research', href: 'research/' }, { label: `Theme ${i + 1} of ${themes.length}` }]}
>
  {(papers.length > 0 || code.length > 0) && (
    <p class="related">
      {papers.length > 0 && <>{plural('Paper', papers.length)}: <Fragment set:html={paperLinks} /></>}
      {papers.length > 0 && code.length > 0 && <br />}
      {code.length > 0 && <>Code: <Fragment set:html={codeLinks} /></>}
    </p>
  )}
  <Fragment slot="after">
    {vids.length > 0 && (
      <section id="demo" class="sec g12" aria-labelledby="h-demo">
        <header data-reveal class="sec-head side"><div class="hd"><span class="num">01</span><h2 id="h-demo">Demo</h2></div></header>
        <div class="vids body-r" data-reveal-group>
          {vids.map((v) => <Video v={v} />)}
        </div>
      </section>
    )}
    <ThemeNav slug={t.slug} />
  </Fragment>
</Stub>
