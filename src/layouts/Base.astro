---
// Every regular page: head (SEO, icons, fonts, analytics), masthead, main, footer.
import '../styles/global.css';
import Icons from '../components/Icons.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { IS_PREVIEW, GOATCOUNTER_CODE, url, absUrl } from '../lib/site';
import { profile } from '../lib/data';

interface Props {
  /** Page title; omit on the homepage. */
  title?: string;
  /** One or two sentences for search results and link previews. */
  description: string;
  /** JSON-LD object (homepage only). */
  jsonLd?: Record<string, unknown>;
  ogType?: 'website' | 'profile' | 'article';
  /** true for pages that should never be indexed (404). */
  noindex?: boolean;
}

const { title, description, jsonLd, ogType = 'website', noindex = false } = Astro.props;
// Browser-tab title format: the ONE place it is defined. Pages pass only their own `title` prop.
const siteName = `${profile.name}, ${profile.suffix}`;
const HOME_TITLE = 'Jihoon Chung | Building Scientist, Developer & Designer';
const fullTitle = title ? `${title} | ${siteName}` : HOME_TITLE;
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = absUrl(profile.headshot);
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script is:inline>
    // Color mode: a choice made with the header switch is kept in localStorage and applied here, before the first
    // paint; without one the page follows the system setting (global.css handles both through data-theme).
    (function (d) {
      try { var t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t); } catch (e) {}
    })(document.documentElement);
  </script>
  <script is:inline>
    // Motion is a progressive enhancement: .js-motion is set before the first paint, and only when the visitor has no
    // reduced-motion preference. If the page script at the end of <body> never starts, everything shows after 3s.
    (function (d) {
      if (!window.matchMedia || !matchMedia('(prefers-reduced-motion: no-preference)').matches) return;
      d.classList.add('js-motion');
      setTimeout(function () { if (!window.__motion) d.classList.remove('js-motion'); }, 3000);
    })(document.documentElement);
  </script>
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  {(IS_PREVIEW || noindex) && <meta name="robots" content="noindex, nofollow">}
  {!IS_PREVIEW && !noindex && <link rel="canonical" href={pageUrl}>}
  <meta property="og:type" content={ogType}>
  <meta property="og:site_name" content={siteName}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={pageUrl}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content={String(profile.headshot_width)}>
  <meta property="og:image:height" content={String(profile.headshot_height)}>
  <meta property="og:image:alt" content={profile.headshot_alt}>
  <meta name="twitter:card" content="summary">
  <link rel="icon" href={url('favicon.ico')} sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href={url('apple-touch-icon-32x32.png')}>
  <link rel="apple-touch-icon" href={url('apple-touch-icon.png')}>
  <link rel="manifest" href={url('site.webmanifest')}>
  <meta name="theme-color" content="#f3f4f1" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#101214" media="(prefers-color-scheme: dark)">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@0,62..125,100..900;1,62..125,100..900&family=Source+Serif+4:ital,wght@0,400..700;1,400..700&family=Barlow+Semi+Condensed:wght@300;600&family=DM+Mono:ital,wght@0,400;0,500;1,400&display=swap">
  {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLdText}></script>}
  {GOATCOUNTER_CODE && <script is:inline data-goatcounter={`https://${GOATCOUNTER_CODE}.goatcounter.com/count`} async src="https://gc.zgo.at/count.js"></script>}
</head>
<body>
  <Icons />
  <a class="skip" href="#main">Skip to content</a>
  <div class="wrap" id="top">
  <div class="frame">
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </div>
  </div>
  <script is:inline>
    // Light/dark switch in the header. It flips to the other mode; a choice that matches the system setting is
    // dropped, so the page follows the system again. The browser bar color (meta theme-color) follows too.
    (function () {
      var d = document.documentElement, btn = document.querySelector('.theme-tg');
      if (!btn) return;
      var mq = window.matchMedia ? matchMedia('(prefers-color-scheme: dark)') : null;
      var metas = Array.prototype.slice.call(document.querySelectorAll('meta[name="theme-color"]'));
      metas.forEach(function (m) { m.setAttribute('data-c', m.getAttribute('content')); });
      var system = function () { return mq && mq.matches ? 'dark' : 'light'; };
      var current = function () { var t = d.getAttribute('data-theme'); return t === 'light' || t === 'dark' ? t : system(); };
      var sync = function () {
        var text = 'Switch to ' + (current() === 'dark' ? 'light' : 'dark') + ' mode';
        btn.setAttribute('aria-label', text);
        btn.title = text;
        var forced = d.getAttribute('data-theme');
        metas.forEach(function (m) { m.setAttribute('content', forced ? (forced === 'dark' ? '#101214' : '#f3f4f1') : m.getAttribute('data-c')); });
      };
      btn.addEventListener('click', function () {
        var next = current() === 'dark' ? 'light' : 'dark';
        if (next === system()) {
          d.removeAttribute('data-theme');
          try { localStorage.removeItem('theme'); } catch (e) {}
        } else {
          d.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
        }
        sync();
      });
      if (mq && mq.addEventListener) mq.addEventListener('change', sync);
      btn.hidden = false;
      sync();
    })();
  </script>
  <script is:inline>
    // Scroll reveal and theme drawing playback (styles: "Scroll reveal" and "Theme drawings" in global.css).
    // Each [data-reveal] element and each child of a [data-reveal-group] gets --rv, 0 to 1, from how far it sits above
    // the bottom edge of the viewport, so it fades in while scrolling down and fades out while scrolling back up, in
    // step with the scroll. Each theme drawing (svg.dg) gets .dg-on while at least a fifth of it is on screen.
    (function () {
      window.__motion = true;
      var root = document.documentElement;
      if (!root.classList.contains('js-motion')) return;
      var all = function (q) { return Array.prototype.slice.call(document.querySelectorAll(q)); };
      var items = all('[data-reveal]').map(function (el) { return { el: el, lag: 0 }; });
      var groups = all('[data-reveal-group]');
      groups.forEach(function (g) {
        Array.prototype.forEach.call(g.children, function (c) { items.push({ el: c, lag: 0, group: g }); });
      });
      var vh = innerHeight, span = 280, ticking = false;
      // Cards side by side in one row lag 40px each, so a row still fills from left to right.
      var measure = function () {
        vh = innerHeight;
        span = Math.min(vh / 3, 280);
        groups.forEach(function (g) {
          var prev = null, lag = 0;
          Array.prototype.forEach.call(g.children, function (c) {
            var t = c.getBoundingClientRect().top;
            lag = prev !== null && Math.abs(t - prev) < 4 ? lag + 40 : 0;
            prev = t;
            items.forEach(function (it) { if (it.el === c) it.lag = lag; });
          });
        });
      };
      var frame = function () {
        ticking = false;
        var maxY = root.scrollHeight - vh;
        // Over the last stretch of the page everything comes fully in, so nothing stays faded at the very end.
        var end = maxY <= 0 ? 1 : Math.max(0, 1 - (maxY - scrollY) / span);
        var focus = document.activeElement;
        var tops = items.map(function (it) { return it.el.getBoundingClientRect().top; });
        items.forEach(function (it, i) {
          var p = Math.max((vh - tops[i] - it.lag) / span, end);
          if (focus && focus !== document.body && it.el.contains(focus)) p = 1;
          p = p <= 0 ? 0 : p >= 1 ? 1 : p * p * (3 - 2 * p);
          var v = p.toFixed(3);
          if (v !== it.v) { it.v = v; it.el.style.setProperty('--rv', v); }
        });
      };
      var request = function () { if (!ticking) { ticking = true; requestAnimationFrame(frame); } };
      measure();
      frame();
      addEventListener('scroll', request, { passive: true });
      addEventListener('resize', function () { measure(); request(); });
      addEventListener('load', function () { measure(); request(); });
      document.addEventListener('focusin', request);
      if (!('IntersectionObserver' in window)) {
        all('svg.dg').forEach(function (d) { d.classList.add('dg-on'); });
        return;
      }
      var play = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          if (e.intersectionRatio >= 0.2) e.target.classList.add('dg-on');
          else if (!e.isIntersecting) e.target.classList.remove('dg-on');
        });
      }, { threshold: [0, 0.2] });
      all('svg.dg').forEach(function (d) { play.observe(d); });
    })();
  </script>
</body>
</html>
