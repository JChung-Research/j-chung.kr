---
// Theme 2 page, from research/mockups/research-geb.html (the inner-page template).
// Lists (software, projects, publications, talks) come from src/data/*.yml; narrative text is below.
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import PubList from '../../components/PubList.astro';
import ThemeNav from '../../components/ThemeNav.astro';
import Geb from '../../components/diagrams/Geb.astro';
import OrbitWireframe from '../../components/diagrams/OrbitWireframe.astro';
import { url } from '../../lib/site';
import {
  themes, publications, projects, recent, software, talks,
  sortPublications, sortByDateDesc, spanYm, spanPeriod, formatYmd, pubByDoi, repoSlug, plural, PUB_GROUP_LABEL,
  type Publication,
} from '../../lib/data';

const SLUG = 'grid-interactive-efficient-buildings';
const themeNo = themes.findIndex((t) => t.slug === SLUG) + 1;
const theme = themes[themeNo - 1];

const lede =
  "Small and medium-sized commercial buildings (SMCBs) are 94% of U.S. commercial buildings and account for nearly half of commercial building energy use, yet they lack affordable, interoperable building energy management (BEM) tools. At Oak Ridge National Laboratory I develop portable, vendor-agnostic BEM and supervisory control for these buildings, supporting the U.S. Department of Energy's Grid-interactive Efficient Buildings initiative.";

const themePubs = sortPublications(publications.filter((p) => p.themes.includes(SLUG)));
const groups = (['journal', 'conference', 'report'] as const)
  .map((type) => ({ type, items: themePubs.filter((p) => p.type === type) }))
  .filter((g) => g.items.length > 0);
const themeProjects = projects.filter((p) => p.theme === SLUG);
// Recent projects in this theme: short list in the page head, linking to their cards on the homepage.
const themeRecent = recent.filter((r) => r.theme === SLUG);
const roles = [...new Set(themeProjects.map((p) => p.role))];
const tool = software.find((s) => s.theme === SLUG);
const themeTalks = sortByDateDesc(talks.filter((t) => t.themes.includes(SLUG)));

// Validation cards (page text). "papers" are publication ids on this page.
const checks: { kick: string; title: string; text: string; label?: string; papers?: string[] }[] = [
  { kick: 'Simulation', title: 'BOPTEST emulator', text: 'Simulation-based validation with the DOE-developed BOPTEST emulator across HVAC system types, including fan coil and hydronic systems.', label: 'Paper', papers: ['sb2026'] },
  { kick: 'Field', title: 'ORNL office building', text: 'Field deployment of the platform in an occupied office building at Oak Ridge National Laboratory.' },
  { kick: 'Laboratory and literature', title: 'Medical offices and industrial facilities', text: 'Laboratory validation for small and medium-sized medical office buildings, and a literature-based feasibility assessment for small and medium industrial facilities.', label: 'Reports', papers: ['tm4854', 'tm4735'] },
];
const pubShort = (id: string) => (publications.find((p) => p.id === id) as Publication).short;

const sections = [
  { id: 'approach', label: 'Approach', show: true },
  { id: 'validation', label: 'Validation', show: true },
  { id: 'orbit', label: 'Design + code', show: !!tool },
  { id: 'projects', label: 'Funded projects', show: themeProjects.length > 0 },
  { id: 'publications', label: 'Publications', show: themePubs.length > 0 },
  { id: 'talk', label: plural('Talk', themeTalks.length), show: themeTalks.length > 0 },
].filter((s) => s.show);
const num = (id: string) => String(sections.findIndex((s) => s.id === id) + 1).padStart(2, '0');
const sb = publications.find((p) => p.id === 'sb2026') as Publication;
---
<Base title={theme.title} description={theme.sentence} ogType="article">
  <PageHead
    crumbs={[{ label: 'Research', href: 'research/' }, { label: `Theme ${themeNo} of ${themes.length}` }]}
    title={theme.title}
    lede={lede}
    toc={sections.map((s) => ({ id: s.id, label: s.label }))}
  >
    {themeRecent.length > 0 && (
      <div class="note">
        <p class="kick" id="recent-h">Projects</p>
        <ul class="plist" aria-labelledby="recent-h">
          {themeRecent.map((r) => (
            <li><a href={url(`#proj-${r.id}`)}>{r.title}</a><span class="mono">{spanPeriod(r.start, r.end)}</span></li>
          ))}
        </ul>
      </div>
    )}
  </PageHead>

  <section id="approach" class="sec g12" aria-labelledby="h-approach">
    <header class="sec-head"><div class="hd"><span class="num">{num('approach')}</span><h2 id="h-approach">Approach</h2></div><p class="sec-intro">A configuration-driven platform that integrates model predictive control, VOLTTRON middleware, Brick Schema semantic models, and the BACnet and Modbus protocols, so that it can be deployed across heterogeneous building stock regardless of equipment vendor.</p></header>
    <div class="spread body-f">
      <figure class="fig main">
        <div class="sheet paper"><a class="fig-link" href={url('images/fig1-bem-architecture.png')}><span class="vh">Open the figure at full size. </span><img width="1400" height="1412" src={url('images/fig1-bem-architecture-1400.webp')} alt="Four-layer system architecture. Application layer: four web clients connect to a web server, and external dashboards run in Grafana. Data management layer: VOLTTRON middleware with five drivers, writing to an InfluxDB time-series database. Network layer: BACnet, Modbus and HTTP or HTTPS. Data source layer: installed control and sensing devices (smart thermostat, IoT sensor, energy meter) and external data sources (electricity price API, carbon intensity API)." decoding="async"></a></div>
        <figcaption><span class="cap">System architecture of the scalable BEM system. Chung et al., SimBuild 2026.</span><a class="doi" href={`https://doi.org/${sb.doi}`} aria-label="DOI for the SimBuild 2026 paper">[DOI]</a></figcaption>
      </figure>
      <div class="aside">
        <div class="note">
          <p class="kick">From model to configuration</p>
          <p>One semantic building model, written in YAML or as a Brick model, generates the configuration files for each building.</p>
        </div>
        <figure class="fig">
          <div class="sheet"><Geb /></div>
          <figcaption><span class="pn">Concept</span><span>Diagram placeholder, to be redrawn</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section id="validation" class="sec g12" aria-labelledby="h-validation">
    <header class="sec-head side"><div class="hd"><span class="num">{num('validation')}</span><h2 id="h-validation">Validation</h2></div></header>
    <ul class="checks body-r">
      {checks.map((c) => (
        <li><p class="kick">{c.kick}</p><h3 class="h3">{c.title}</h3><p class="d">{c.text}</p>{c.papers && <p class="related">{c.label}: <Fragment set:html={c.papers.map((id) => `<a href="#p-${id}">${pubShort(id)}</a>`).join(' · ')} /></p>}</li>
      ))}
    </ul>
  </section>

  {tool && (
    <section id="orbit" class="sec g12" aria-labelledby="h-orbit">
      <header class="sec-head"><div class="hd"><span class="num">{num('orbit')}</span><h2 id="h-orbit">Design <span class="nw">+ code</span></h2></div><p class="sec-intro">{tool.name}, the open-source platform from this theme: how it looks to a building operator, and what it is built with.</p></header>
      <div class="spread body-f">
        <OrbitWireframe />
        <div class="aside orbit">
          <div class="prod"><p class="name">{tool.name}</p>{tool.full_name && <p class="meta">{tool.full_name}</p>}</div>
          <p class="d">{tool.description}</p>
          <div class="stack">
            <p class="kick" id="stack-h">Stack</p>
            <ul class="ec-tags" aria-labelledby="stack-h">
              {tool.stack.map((s) => <li>{s}</li>)}
            </ul>
          </div>
          {tool.credit && <p class="credit">{tool.credit}</p>}
          <a class="repo" href={tool.repo}><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-github"/></svg><span><b>Source code on GitHub</b><i>{repoSlug(tool.repo)}</i></span></a>
        </div>
      </div>
      {tool.features.length > 0 && (
        <ul class="feats body-f" aria-label={`What ${tool.name} does`}>
          {tool.features.map((f) => <li><p class="kick">{f.label}</p><p>{f.text}</p></li>)}
        </ul>
      )}
    </section>
  )}

  {themeProjects.length > 0 && (
    <section id="projects" class="sec g12" aria-labelledby="h-projects">
      <header class="sec-head side"><div class="hd"><span class="num">{num('projects')}</span><h2 id="h-projects">Funded projects</h2><p class="hd-role"><span class="kick">Role</span>{roles.join('; ')}</p></div></header>
      <div class="body-r">
        <ol class="pubs">
          {themeProjects.map((p) => {
            const report = p.report_doi ? pubByDoi(p.report_doi) : undefined;
            const [from, to] = spanYm(p.start, p.end).split(' to ');
            return (
              <li><span class="yr"><span class="nw">{from}</span> <span class="nw">to {to}</span></span><div class="entry"><p class="t">{p.title}</p><p class="v">{p.sponsor}</p>{report && <p class="related">Report: <a href={`#p-${report.id}`}>{report.short}</a></p>}</div></li>
            );
          })}
        </ol>
        <p class="collab">In collaboration with Pacific Northwest National Laboratory, AReCoS LLC, and the Alliance for Energy Innovation.</p>
      </div>
    </section>
  )}

  {themePubs.length > 0 && (
    <section id="publications" class="sec g12" aria-labelledby="h-pubs">
      <header class="sec-head side"><div class="hd"><span class="num">{num('publications')}</span><h2 id="h-pubs">Publications</h2></div></header>
      <div class="body-r">
        {groups.map((g) => (
          <>
            <p class="kick grp">{plural(PUB_GROUP_LABEL[g.type], g.items.length)}</p>
            <PubList items={g.items} variant="full" />
          </>
        ))}
      </div>
    </section>
  )}

  {themeTalks.length > 0 && (
    <section id="talk" class="sec g12" aria-labelledby="h-talk">
      <header class="sec-head side"><div class="hd"><span class="num">{num('talk')}</span><h2 id="h-talk">{plural('Talk', themeTalks.length)}</h2></div></header>
      <ol class="pubs body-r">
        {themeTalks.map((t) => (
          <li><time class="yr" datetime={t.date}>{formatYmd(t.date)}</time><div class="entry"><p class="t">{t.link ? <a href={t.link}>{t.title}</a> : t.title}</p><p class="v"><i>{t.event}</i>{[t.organizer, t.place].filter(Boolean).map((x) => `, ${x}`).join('')}.</p></div></li>
        ))}
      </ol>
    </section>
  )}

  <ThemeNav slug={SLUG} />
</Base>
