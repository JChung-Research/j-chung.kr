---
// Contact: the owner's original contact form from the old site, rebuilt in this site's style. Same Formspree form
// (profile.yml contact_form), same four fields in the same order (email, name, subject, message), same subject line
// for the inbox and the same hidden spam trap. No email address appears on the site. The form has Formspree's
// reCAPTCHA on, so it posts the normal way: Formspree shows the check and its thank-you page, as on the old site.
// Until a form ID is set the page shows a short note instead of the form.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { profile } from '../lib/data';

const L = profile.links;
const key = (profile.contact_form.key ?? '').trim();
const action = key ? `https://formspree.io/f/${key}` : '';
---
<Base title="Contact" description={`Send a message to ${profile.name}, ${profile.suffix}.`}>
  <PageHead crumbs={[{ label: 'Home', href: '' }, { label: 'Contact' }]} title="Contact" lede="If you have a question or would like to know more about my work, send a message here and I will reply by email." />

  <section id="message" class="sec g12" aria-labelledby="h-message">
    <header data-reveal class="sec-head side"><div class="hd"><span class="num">01</span><h2 id="h-message">Send a message</h2></div></header>
    <div class="cform-wrap body-r" data-reveal>
      {action ? (
        <form class="cform" action={action} method="POST">
          <input type="hidden" name="_subject" value="New Contact Form Submission">
          <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <div class="cf-row">
            <div class="cf-field"><label for="cf-email">Email address <span class="cf-note">for my reply</span></label><input id="cf-email" name="email" type="email" autocomplete="email" required></div>
            <div class="cf-field"><label for="cf-name">Name</label><input id="cf-name" name="name" type="text" autocomplete="name" required></div>
          </div>
          <div class="cf-field"><label for="cf-subject">Subject</label><input id="cf-subject" name="subject" type="text"></div>
          <div class="cf-field"><label for="cf-msg">Message</label><textarea id="cf-msg" name="message" rows="9" required></textarea></div>
          <div class="cf-foot">
            <button class="cf-send" type="submit">Send message</button>
            <p class="cf-privacy">Messages are delivered by Formspree, which may ask you to confirm that you are not a robot. Your email address is used only to reply.</p>
          </div>
        </form>
      ) : (
        <p class="cf-pending">The message form is being set up. Until it opens, you can reach me on <a href={L.linkedin}>LinkedIn</a>.</p>
      )}
    </div>
  </section>

  <section id="elsewhere" class="sec g12" aria-labelledby="h-elsewhere">
    <header data-reveal class="sec-head side"><div class="hd"><span class="num">02</span><h2 id="h-elsewhere">Elsewhere</h2></div></header>
    <ul class="cf-links body-r" data-reveal-group>
      <li><a class="repo" href={L.linkedin}><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-linkedin"/></svg><span><b>LinkedIn</b><i>{L.linkedin.replace(/\/+$/, '').split('/').pop()}</i></span></a></li>
      <li><a class="repo" href={L.scholar}><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-scholar"/></svg><span><b>Google Scholar</b><i>Publications and citations</i></span></a></li>
      <li><a class="repo" href={L.orcid}><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-orcid"/></svg><span><b>ORCID</b><i>{L.orcid_id}</i></span></a></li>
      <li><a class="repo" href={L.github}><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-github"/></svg><span><b>GitHub</b><i>{L.github_handle}</i></span></a></li>
    </ul>
  </section>
</Base>
