---
// Homepage: Mockup A (research/mockups/mockup-a.html), rendered from src/data/*.yml.
import Base from '../layouts/Base.astro';
import PubList from '../components/PubList.astro';
import ThemeDiagram from '../components/diagrams/ThemeDiagram.astro';
import ProjectDiagram from '../components/diagrams/ProjectDiagram.astro';
import DesignStrip from '../components/home/DesignStrip.astro';
import { url, absUrl } from '../lib/site';
import {
  profile, education, news, software, themes, recent,
  sortByDateDesc, formatYm, newsHtml, homePublications,
  educationFieldHtml, headlineHtml, pubById, softwareById, themeBySlug, spanPeriod,
} from '../lib/data';

// Highlights only: the newest news items and three selected publications; the full lists have their own pages.
const HOME_NEWS_COUNT = 3;
const latestNews = sortByDateDesc(news).slice(0, HOME_NEWS_COUNT);
const L = profile.links;

// Recent Projects: paper and report links go to the DOI, code links to the repository.
const pubLink = (id: string) => {
  const p = pubById(id);
  const label = p.type === 'conference' && p.pages ? `${p.short}, pp. ${p.pages}` : p.short;
  return { href: `https://doi.org/${p.doi}`, label };
};
const projectLinks = (r: (typeof recent)[number]) =>
  [
    r.paper && { kind: 'Paper', ...pubLink(r.paper) },
    r.report && { kind: 'Report', ...pubLink(r.report) },
    r.code && { kind: 'Code', href: softwareById(r.code).repo, label: softwareById(r.code).name },
  ].filter(Boolean) as { kind: string; href: string; label: string }[];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  honorificSuffix: profile.suffix,
  jobTitle: profile.role.title,
  affiliation: { '@type': 'Organization', name: profile.role.organization },
  alumniOf: [...new Set(education.map((e) => e.school))].map((name) => ({ '@type': 'CollegeOrUniversity', name })),
  sameAs: [L.scholar, L.orcid, L.linkedin, L.github, L.ornl],
  url: absUrl(''),
  image: absUrl(profile.headshot),
  email: `mailto:${profile.email}`,
};
---
<Base description={profile.description} jsonLd={jsonLd} ogType="profile">
  <section class="hero g12" aria-label="Introduction">
    <div class="hero-main">
      <h1>{profile.name}, <span class="phd">{profile.suffix}</span></h1>
      <p id="headline" set:html={headlineHtml(profile.headline)} />
      <p class="role">{profile.role.title}, {profile.role.group}, {profile.role.organization}</p>
      <p class="lede">{profile.bio}</p>
      <div class="ec">
        <ul class="ec-list" aria-label="Education">
          {education.map((e) => (
            <li><b>{e.degree}</b> <Fragment set:html={educationFieldHtml(e)} />, <span class="nw">{e.school}</span><span class="ec-yr">{e.year}</span></li>
          ))}
        </ul>
        <ul class="ec-tags" aria-label="Credentials">
          {profile.credentials.map((c) => <li title={`${c.issuer}, ${c.year}`}>{c.name}</li>)}
        </ul>
      </div>
    </div>
    <aside class="hero-side" aria-label="Portrait and profiles">
      <figure class="portrait"><img src={url(profile.headshot)} width={profile.headshot_width} height={profile.headshot_height} alt={profile.headshot_alt}></figure>
      <ul class="ids" aria-label="Email and profiles">
        <li><a href={`mailto:${profile.email}`} aria-label="Email" title={profile.email}><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-mail"/></svg></a></li>
        <li><a href={L.scholar} aria-label="Google Scholar" title="Google Scholar"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-scholar"/></svg></a></li>
        <li><a href={L.orcid} aria-label="ORCID" title={`ORCID ${L.orcid_id}`}><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-orcid"/></svg></a></li>
        <li><a href={L.linkedin} aria-label="LinkedIn" title="LinkedIn"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-linkedin"/></svg></a></li>
        <li><a href={L.github} aria-label="GitHub" title={`GitHub: ${L.github_handle}`}><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-github"/></svg></a></li>
      </ul>
    </aside>
    <nav class="tcards" aria-label="Research themes">
      <ul>
        {themes.map((t, i) => (
          <li class="tcard">
            <div class="tc-fig sheet"><ThemeDiagram name={t.diagram} /></div>
            <span class="ti-n">Theme {i + 1}</span>
            <a class="ti-t" href={url(`research/${t.slug}/`)}>{t.title}</a>
            <p class="tc-s">{t.card}</p>
          </li>
        ))}
      </ul>
    </nav>
  </section>

  <section id="news" class="sec g12" aria-labelledby="h-news">
    <header class="sec-head side"><div class="hd"><span class="num">01</span><h2 id="h-news">News</h2></div></header>
    <div class="body-r">
      <ol class="news">
        {latestNews.map((n) => (
          <li><time datetime={n.date}>{formatYm(n.date)}</time><p set:html={newsHtml(n)} /></li>
        ))}
      </ol>
      <p class="more"><a href={url('news/')}>All news</a></p>
    </div>
  </section>

  <section id="projects" class="sec g12" aria-labelledby="h-projects">
    <header class="sec-head"><div class="hd"><span class="num">02</span><h2 id="h-projects">Recent Projects</h2></div><p class="sec-intro">Recent projects across the three themes, each drawn from its published paper, report or code.</p></header>
    <ul class="rprojects body-f">
      {recent.map((r) => {
        const theme = themeBySlug(r.theme);
        return (
          <li class="rp" id={`proj-${r.id}`}>
            <div class="rp-fig sheet"><ProjectDiagram name={r.diagram} /></div>
            <h3 class="rp-t">{r.title}</h3>
            <p class="rp-m"><span class="nw">{spanPeriod(r.start, r.end)}</span><br />{r.host}{r.sponsor && <><br />{r.sponsor}</>}</p>
            <p class="rp-d">{r.line}</p>
            <ul class="rp-l">
              {projectLinks(r).map((l) => <li>{l.kind}: <a href={l.href}>{l.label}</a></li>)}
            </ul>
            <p class="rp-tag">Theme: <a href={url(`research/${theme.slug}/`)}>{theme.title}</a></p>
          </li>
        );
      })}
    </ul>
    <p class="more body-f"><a href={url('research/')}>All research themes</a></p>
  </section>

  <section id="software" class="sec g12" aria-labelledby="h-sw">
    <header class="sec-head"><div class="hd"><span class="num">03</span><h2 id="h-sw">Software</h2></div><p class="sec-intro">The software I write for my research: what each tool does, the languages it uses, and its code.</p></header>
    <div class="body-r">
      <ul class="tools">
        {software.map((s) => (
          <li id={`sw-${s.id}`}><p class="name">{s.name}</p><p class="meta">{[s.full_name, s.language, s.license && `${s.license} License`].filter(Boolean).join(' · ')}</p><p class="d">{s.description}</p><p class="mono"><a class="ref" href={s.repo}>[repo]</a></p></li>
        ))}
      </ul>
      <p class="more"><a href={url('software/')}>See all software</a></p>
    </div>
  </section>

  <section id="design" class="sec g12" aria-labelledby="h-design">
    <header class="sec-head"><div class="hd"><span class="num">04</span><h2 id="h-design">Design</h2></div><p class="sec-intro">Design is part of how I do research: I design the interfaces and visualizations of the tools I build, and I bring computational and architectural design into building technology.</p></header>
    <div class="body-r">
      <DesignStrip />
      <p class="more"><a href={url('design/')}>See the Design page</a><a href={L.instagram}>More design work on Instagram (@{L.instagram_handle})</a></p>
    </div>
  </section>

  <section id="publications" class="sec g12" aria-labelledby="h-pubs">
    <header class="sec-head side"><div class="hd"><span class="num">05</span><h2 id="h-pubs">Selected publications</h2></div></header>
    <div class="body-r">
      <PubList items={homePublications} variant="compact" />
      <p class="more"><a href={url('publications/')}>All publications</a><a href={L.scholar}>Google Scholar</a></p>
    </div>
  </section>
</Base>
